---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
const conditions = [
  { number: '01', title: 'Everyday pain & discomfort', text: 'Individual care for back and neck pain, headaches, disc issues, and TMJ discomfort.', tags: ['Back & neck', 'Headaches', 'TMJ'] },
  { number: '02', title: 'Injury & active recovery', text: 'Support after trauma, sports injuries, and auto accidents—plus exercises to strengthen problem areas.', tags: ['Sports injuries', 'Auto accidents', 'Extremities'] },
  { number: '03', title: 'Care for every stage of life', text: 'A thoughtful approach for athletes, working professionals, students, grandparents, and growing families.', tags: ['Pregnancy', 'Pediatric care', 'Older adults'] },
];
const faqs = [
  { q: 'Are you accepting new patients?', a: 'We welcome people of all ages. Call (802) 557-8568 to discuss your needs and schedule your first visit.' },
  { q: 'Do you accept my insurance?', a: 'The practice accepts most insurance plans, including auto accident, personal injury, and workers’ compensation coverage. Providers include BCBS-VT, Cigna, Medicare, and Medicaid. Please call to verify your specific plan and coverage before your visit.' },
  { q: 'Can I get a same-day appointment?', a: 'Same-day appointments are often available. Call the office to check current availability and find a time that works with your schedule.' },
  { q: 'Where is the office?', a: 'Find us at 595 Dorset Street, Suite 8, South Burlington, VT 05403. Use the same driveway as City Hall, then bear left.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'MedicalBusiness', name: 'Elevate Health Chiropractic', telephone: '+1-802-557-8568', email: 'info@elevatehealthchiropractic.com', address: { '@type': 'PostalAddress', streetAddress: '595 Dorset Street, Suite 8', addressLocality: 'South Burlington', addressRegion: 'VT', postalCode: '05403', addressCountry: 'US' } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#222426" />
    <meta name="description" content="Gentle, personalized chiropractic care with Dr. Paul Samuel in South Burlington, Vermont. Call (802) 557-8568 to schedule a visit. Same-day appointments often available." />
    <meta property="og:title" content="Elevate Health Chiropractic | Less pain. More life." />
    <meta property="og:description" content="Personalized chiropractic care in South Burlington, Vermont. Meet Dr. Paul Samuel and take the next step toward moving better." />
    <meta property="og:type" content="website" />
    <title>Elevate Health Chiropractic | South Burlington, VT</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="topline"><div class="container topline-inner"><span>Personalized care. Right here in Vermont.</span><a href="https://www.google.com/maps/search/?api=1&query=Elevate+Health+Chiropractic+595+Dorset+Street+South+Burlington+VT" target="_blank" rel="noopener noreferrer"><Icon name="pin" size={13} /> South Burlington, VT <Icon name="diagonal" size={12} /></a></div></div>
    <header class="header">
      <div class="container header-inner">
        <a href="#top" class="logo" aria-label="Elevate Health Chiropractic home"><img src="/images/logo.png" alt="Elevate Health" width="200" height="50" /><span>CHIROPRACTIC</span></a>
        <button class="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="Open navigation"><span></span><span></span></button>
        <nav id="navigation" aria-label="Main navigation">
          <a href="#care">Our care</a><a href="#doctor">Meet Dr. Paul</a><a href="#patients">Patient info</a>
          <a href="tel:+18025578568" class="nav-phone">(802) 557-8568</a>
          <a href="#contact" class="button button-white button-small">Schedule a visit <Icon name="arrow" size={17} /></a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero" id="top">
        <div class="container hero-layout">
          <div class="hero-copy">
            <p class="eyebrow light"><span class="red-dot"></span> YOUR LIFE. YOUR HEALTH.</p>
            <h1>Less pain.<br /><span>More life.</span></h1>
            <p class="hero-description">Gentle chiropractic care that puts you first.<br class="desktop-break" /> Get back to moving, feeling, and living better.</p>
            <div class="hero-actions"><a href="#contact" class="button button-red">Schedule your first visit <Icon name="arrow" /></a><a href="tel:+18025578568" class="button button-outline"><Icon name="phone" size={17} /> Call our office</a></div>
            <p class="availability"><span></span> Same-day appointments often available</p>
          </div>
          <div class="hero-visual">
            <img class="hero-photo" src="/images/chiropractic-care.jpg" alt="Hands-on chiropractic adjustment" width="970" height="400" fetchpriority="high" />
            <div class="image-label"><span class="image-label-icon"><Icon name="check" size={18} /></span><div><strong>Hands-on care. A personal approach.</strong><span>With Dr. Paul Samuel, DC</span></div></div>
            <div class="hero-caption"><span>Enjoy life, maximize your health.</span><span>EST. 2007</span></div>
          </div>
        </div>
        <div class="container hero-bottom"><span>Care for the greater Burlington community</span><a href="#care">Discover a better way to feel <span>↓</span></a></div>
      </section>
      <section class="trust-strip" aria-label="Practice highlights"><div class="container trust-grid">
        <div><Icon name="check" /><span>Serving Burlington <strong>since 2007</strong></span></div>
        <div><Icon name="check" /><span><strong>Most insurance</strong> plans accepted</span></div>
        <div><Icon name="check" /><span>Personalized care <strong>for all ages</strong></span></div>
      </div></section>

      <section id="care" class="section care-section">
        <div class="container">
          <div class="section-head"><div><p class="eyebrow">CARE THAT MEETS YOU WHERE YOU ARE</p><h2>Feel better.<br />Do more of what you love.</h2></div><p>Life doesn’t slow down when pain shows up. We take time to understand your needs and tailor your care—so you can move forward with confidence.</p></div>
          <div class="care-grid">{conditions.map(c => <article class="care-item"><div class="care-top"><span>{c.number}</span><Icon name="diagonal" size={23} /></div><h3>{c.title}</h3><p>{c.text}</p><div class="tags">{c.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div>
          <div class="care-footer"><p>Not sure where to start? We’re here to help.</p><a href="tel:+18025578568" class="inline-link">Let’s talk about your care <Icon name="arrow" size={18} /></a></div>
        </div>
      </section>

      <section id="doctor" class="section doctor-section">
        <div class="container doctor-layout">
          <div class="doctor-portrait"><div class="portrait-top"><span>YOUR PARTNER IN BETTER HEALTH</span><span>01 / TEAM</span></div><img src="/images/dr-paul-samuel.jpg" alt="Dr. Paul Samuel, Doctor of Chiropractic" width="350" height="321" loading="lazy" /><div class="portrait-bottom"><div><strong>Dr. Paul Samuel</strong><span>Doctor of Chiropractic</span></div><span class="dc-badge">DC</span></div></div>
          <div class="doctor-copy"><p class="eyebrow">A FAMILIAR FACE. A THOUGHTFUL APPROACH.</p><h2>Good care starts<br />with being heard.</h2><p>Dr. Paul Samuel has served Burlington, Shelburne, and the surrounding communities since 2007. His approach is thorough, gentle, and personal—with time to answer your questions and explain your care.</p><p>Inspired by the difference chiropractic made in his own family, Dr. Paul earned his Doctor of Chiropractic from Life University. He works with your other health practitioners to coordinate supportive care.</p><div class="doctor-values"><span><Icon name="check" size={17} /> Care tailored to you</span><span><Icon name="check" size={17} /> Clear answers, every step</span></div><details class="bio-details"><summary>More about Dr. Paul’s background <Icon name="plus" size={18} /></summary><p>Dr. Paul received his Bachelor of Science from the University of Wisconsin and his chiropractic degree from Life University College of Chiropractic in Marietta, Georgia. His continuing education includes sacro-occipital technique, applied kinesiology, cranial sacral manipulative reflex technique, nutritional therapy, pediatric adjusting, and extremity adjusting.</p><p>His experience includes pregnancy and pediatric chiropractic, sports and car accident injuries, ergonomics, and care for older adults.</p></details><a href="#contact" class="button button-dark">Meet Dr. Paul at your first visit <Icon name="arrow" size={18} /></a></div>
        </div>
      </section>

      <section class="section approach-section"><div class="container approach-layout"><div><p class="eyebrow light">YOUR LIFE, YOUR HEALTH</p><h2>A little more movement.<br />A lot more possibility.</h2><p>Chiropractic care focuses on how your joints move and how your body functions. Dr. Paul uses hands-on adjustments and personalized guidance to help you work toward your goals.</p><a href="#contact" class="inline-link light-link">Find your next step <Icon name="arrow" /></a></div><div class="approach-steps"><article><span>01</span><div><h3>Understand your needs</h3><p>Your concerns, daily life, and goals shape the conversation.</p></div></article><article><span>02</span><div><h3>Care built around you</h3><p>A tailored approach to comfort, mobility, and recovery.</p></div></article><article><span>03</span><div><h3>Keep moving forward</h3><p>Exercises and guidance to strengthen problem areas and support your progress.</p></div></article></div></div></section>

      <section class="section testimonials"><div class="container"><div class="section-head"><div><p class="eyebrow">FROM OUR COMMUNITY</p><h2>Real people.<br />Personal care.</h2></div><p>Kindness, trust, and feeling listened to.<br />Here’s what patients share about their experience.</p></div><div class="quotes"><figure><span class="quote-mark" aria-hidden="true">“</span><blockquote>He cares about my health and really considers my own needs in terms of treatment. I highly recommend him!</blockquote><figcaption><span class="avatar">CB</span><span><strong>Chris B.</strong><small>Burlington, VT</small></span></figcaption></figure><figure><span class="quote-mark" aria-hidden="true">“</span><blockquote>Dr. Paul has gifted hands, and a great heart to go with them. Coming out of his office, I always feel cared for as well as better informed and motivated.</blockquote><figcaption><span class="avatar">MS</span><span><strong>Mary Jane S.</strong><small>Burlington, VT</small></span></figcaption></figure></div></div></section>

      <section id="patients" class="section patients-section"><div class="container patients-layout"><div><p class="eyebrow">A SIMPLE START</p><h2>A few answers.<br />One less thing to worry about.</h2><p>Getting care should feel straightforward. Have another question? Just give us a call.</p><a href="tel:+18025578568" class="inline-link"><Icon name="phone" size={18} /> (802) 557-8568</a><div class="insurance-note"><strong>Insurance, made clearer.</strong><p>BCBS-VT · Cigna · Medicare · Medicaid<br />Call us to verify your plan’s coverage.</p></div></div><div class="faq-list">{faqs.map((faq, i) => <details open={i === 0}><summary>{faq.q}<Icon name="plus" size={20} /></summary><p>{faq.a}</p></details>)}</div></div></section>

      <section id="contact" class="section contact-section"><div class="container"><div class="contact-head"><p class="eyebrow light">LET’S GET YOU FEELING BETTER</p><h2>Your next chapter<br />starts with a conversation.</h2><p>Call to schedule your visit. We’ll help you find a time that works for you.</p><div class="contact-actions"><a href="tel:+18025578568" class="button button-red"><Icon name="phone" size={18} /> Call (802) 557-8568</a><a href="mailto:info@elevatehealthchiropractic.com?subject=Appointment%20inquiry" class="button button-outline"><Icon name="mail" size={18} /> Email our office</a></div><p class="contact-note">Same-day appointments often available · Most insurance plans accepted</p></div><div class="location-row"><div><span class="location-icon"><Icon name="pin" size={23} /></span><div><h3>Come say hello.</h3><address>595 Dorset Street, Suite 8<br />South Burlington, VT 05403</address><p>Same driveway as City Hall, then bear left.</p></div></div><a class="directions" href="https://www.google.com/maps/search/?api=1&query=Elevate+Health+Chiropractic+595+Dorset+Street+South+Burlington+VT" target="_blank" rel="noopener noreferrer">Get directions <Icon name="diagonal" size={18} /></a></div></div></section>
    </main>
    <footer><div class="container footer-main"><a class="logo" href="#top" aria-label="Elevate Health Chiropractic home"><img src="/images/logo.png" width="200" height="50" alt="Elevate Health" /><span>CHIROPRACTIC</span></a><p>Enjoy life, maximize your health.</p><a href="https://www.facebook.com/elevatehealthchiropractic" target="_blank" rel="noopener noreferrer">Facebook <Icon name="diagonal" size={15} /></a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Elevate Chiropractic, LLC</span><a href="#top">Back to top ↑</a></div></footer>
    <div class="mobile-cta"><a href="tel:+18025578568"><Icon name="phone" size={18} /> Call to schedule <span>(802) 557-8568</span></a></div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#navigation');
      const closeMenu = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Open navigation');
        nav?.classList.remove('open');
      };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        nav?.classList.toggle('open', open);
      });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') closeMenu(); });
      document.addEventListener('click', event => { if (event.target instanceof Node && !document.querySelector('.header')?.contains(event.target)) closeMenu(); });
    </script>
  </body>
</html>
